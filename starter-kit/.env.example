# Leave unset to run every adapter against its built-in example dataset —
# the server works out of the box with no credentials.

PORT=3000

# CRM adapter (generic REST, HubSpot/Pipedrive-shaped)
CRM_BASE_URL=
CRM_API_KEY=

# Internal DB adapter — the example ships in-memory; wire a real
# connection string in src/adapters/internal-db.example.ts (see comments
# there) and read it here, e.g. INTERNAL_DB_URL=postgres://...
INTERNAL_DB_URL=

# Generic API adapter
API_BASE_URL=
API_KEY=

# GitHub adapter (src/adapters/github.ts) — real REST API integration, no
# mock fallback. Leave unset to disable the adapter and github_sync_to_db
# tool entirely (rest of the server still runs with no credentials).
#   GITHUB_TOKEN=$(gh auth token)   # reuses your local `gh` auth
GITHUB_TOKEN=
GITHUB_ORG=HELLFIRE-Solutions

# github_sync_to_db tool / `npm run sync` — connection string for the
# mcp_sync_app role against internal-db (see
# internal-db/migrations/0009_mcp_sync_schema.sql and
# internal-db/scripts/set-mcp-sync-app-password.sh). Not the same
# credential as INTERNAL_DB_URL above (different role, different schema).
MCP_SYNC_DATABASE_URL=
